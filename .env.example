# Frontend env (Vite exposes only VITE_* vars to the browser).
# Copy to .env.local for dev. Never put secrets here: everything below is public.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Strava is built but hidden by default. Set to true to show the Strava card.
VITE_ENABLE_STRAVA=false

# Strava app Client ID (public). The client SECRET lives only in Edge Function secrets.
VITE_STRAVA_CLIENT_ID=

# Base URL of the Garmin service (no trailing slash).
# Local dev:  http://localhost:8000
# Production: the Fly.io URL, e.g. https://training-tracker-garmin.fly.dev
VITE_GARMIN_API_URL=http://localhost:8000
