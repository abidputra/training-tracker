# Frontend env (Vite exposes only VITE_* vars to the browser).
# Copy to .env.local for dev. Never put secrets here: everything below is public.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Strava app Client ID (public). The client SECRET lives only in Edge Function secrets.
VITE_STRAVA_CLIENT_ID=

# Base URL of the deployed Garmin service (no trailing slash).
VITE_GARMIN_API_URL=http://localhost:8000
