# Edge Function secrets.
# Set them with:  supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.)

# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Any random string. Must equal the verify_token you use when creating the
# Strava push subscription (see README step 5).
STRAVA_VERIFY_TOKEN=

# The "id" Strava returns when the subscription is created. Set it AFTER
# creating the subscription; events from any other subscription are rejected.
STRAVA_SUBSCRIPTION_ID=

# Your PWA origin, e.g. https://tracker.example.com (use * only for local dev).
ALLOWED_ORIGIN=*
