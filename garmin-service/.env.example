# Garmin service environment. Copy to .env for local runs; set as host secrets in production.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Any long random string; the same value goes into supabase/cron.sql
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_SECRET=

# Strava API app (https://www.strava.com/settings/api). Optional: leave empty to
# disable Strava. The Client ID is public (also put it in the frontend as
# VITE_STRAVA_CLIENT_ID); the Client Secret must stay here, server-side only.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Browser origins allowed to call this service (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173
